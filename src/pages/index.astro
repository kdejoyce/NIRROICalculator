---
import ROICalculator from '../components/ROICalculator';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Estimate your financial impact from faster Active Directory forest recovery with Netwrix Identity Recovery." />
    <title>Identity Recovery ROI Calculator | Netwrix</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hubot+Sans:wght@400;500;600;700&family=Syne:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/print.css" media="print" />
  </head>
  <body class="bg-surface-subtle min-h-screen">

    <!-- Page intro -->
    <main>
      <div class="max-w-[760px] mx-auto px-4 mobile:px-6 pt-10 pb-0">
        <div class="mb-8">
          <p class="text-[0.72rem] font-semibold font-syne text-vigilant-blue uppercase tracking-[0.08em] mb-2">
            Identity Recovery
          </p>
          <h1 class="font-hubot font-bold text-nightwatch leading-[1.15] tracking-[-0.02em] mb-[0.625rem]" style="font-size: clamp(1.5rem, 3.5vw, 2.25rem)">
            How much could you save with faster AD recovery?
          </h1>
          <p class="text-[0.9rem] text-text-muted font-syne leading-[1.6] max-w-[560px] mb-3">
            Estimate your financial impact from reducing forest-level Active Directory recovery time after a ransomware, wiper, or domain compromise event.
          </p>
          <a
            href="https://netwrix.com/en/products/identity-recovery-software/"
            class="inline-block text-[0.875rem] font-semibold font-syne text-vigilant-blue hover:opacity-75 transition-standard"
          >
            Learn about Netwrix Identity Recovery →
          </a>
        </div>
      </div>

      <!-- Calculator island -->
      <ROICalculator client:only="react" />
    </main>

    <!-- Footer -->
    <footer class="max-w-[760px] mx-auto px-4 mobile:px-6 py-8">
      <p class="text-[0.75rem] text-text-faint font-syne leading-[1.6] mb-3">
        This document is for informational purposes only and does not constitute a commitment from Netwrix Corporation of any return on investment from the Netwrix products or services. Netwrix hereby disclaims all warranties related to the information in this document, whether express or implied, including but not limited to the implied warranties of merchantability and fitness for a particular purpose. This document does not provide you with any legal rights whatsoever including, without limitation, with respect to the information you submitted to generate an estimated return on investment or the estimated return on investment generated by that information. You may copy and use this document only for your internal, reference purposes.
      </p>
      <p class="text-[0.75rem] text-text-faint font-syne">
        © {new Date().getFullYear()} Netwrix Corporation. All rights reserved.
      </p>
    </footer>
  </body>
</html>
